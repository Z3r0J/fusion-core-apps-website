{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "fusion-core-apps.vercel.app" }],
      "destination": "https://www.fusioncoreapps.com/:path*",
      "permanent": true
    },
    {
      "source": "/blog/claimly-ya-disponible-google-play",
      "destination": "/es/blog/claimly-ya-disponible-google-play",
      "permanent": true
    },
    {
      "source": "/pt/blog/claimly-ya-disponible-google-play",
      "destination": "/pt/blog/claimly-agora-disponivel-google-play",
      "permanent": true
    },
    {
      "source": "/pt/blog/best-bible-apps-android-2026",
      "destination": "/blog/best-bible-apps-android-2026",
      "permanent": true
    },
    {
      "source": "/blog/best-before-vs-use-by-dates",
      "destination": "https://expiroo.app/en/blog/best-before-vs-use-by",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "query",
          "key": "from"
        }
      ],
      "destination": "/:path*",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "query",
          "key": "utm_source"
        }
      ],
      "destination": "/:path*",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "query",
          "key": "utm_medium"
        }
      ],
      "destination": "/:path*",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "query",
          "key": "utm_campaign"
        }
      ],
      "destination": "/:path*",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "query",
          "key": "utm_term"
        }
      ],
      "destination": "/:path*",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "query",
          "key": "utm_content"
        }
      ],
      "destination": "/:path*",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
