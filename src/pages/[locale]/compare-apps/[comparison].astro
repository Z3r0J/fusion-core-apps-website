---
import ComparisonJsonLd from "@/components/ComparisonJsonLd.astro";
import ComparisonLayout from "@/components/ComparisonLayout.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { type Locale } from "@/i18n/utils";
import { COMPARE_APP_META, comparisonPath, comparisonSlug } from "@/lib/compareApps";
import { withBrand } from "@/lib/seo";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
	const locales: Locale[] = ["es", "pt"];
	const paths = [];

	for (const locale of locales) {
		const entries = await getCollection("comparisons", ({ slug }) =>
			slug.startsWith(`${locale}/`),
		);
		for (const e of entries) {
			paths.push({
				params: {
					locale,
					comparison: comparisonSlug(e.data.app, e.data.competitorSlug),
				},
				props: { entry: e, locale },
			});
		}
	}

	return paths;
}

const { entry, locale } = Astro.props as { entry: any; locale: Locale };
const { Content } = await entry.render();

// Resolve related items from same-locale entries of the same app
const allLocale = await getCollection("comparisons", ({ slug }) =>
	slug.startsWith(`${locale}/`),
);
const relatedItems = (entry.data.relatedSlugs ?? [])
	.map((s: string) => {
		const match = allLocale.find(
			(e: any) => e.data.app === entry.data.app && e.data.competitorSlug === s,
		);
		return match
			? { slug: match.data.competitorSlug, competitorName: match.data.competitorName }
			: null;
	})
	.filter(Boolean) as { slug: string; competitorName: string }[];

const canonical = new URL(
	comparisonPath(locale, entry.data.app, entry.data.competitorSlug),
	Astro.site,
).href;
const ogImage = COMPARE_APP_META[entry.data.app as keyof typeof COMPARE_APP_META].ogImage;
---

<BaseLayout
	title={withBrand(entry.data.title)}
	description={entry.data.description}
	ogImage={ogImage.src}
	ogImageWidth={ogImage.width}
	ogImageHeight={ogImage.height}
	canonical={canonical}
	locale={locale}
	showFooterCta={false}
>
	<ComparisonJsonLd entry={entry} url={canonical} locale={locale} />
	<ComparisonLayout {...entry.data} locale={locale} relatedItems={relatedItems}>
		<Content />
	</ComparisonLayout>
</BaseLayout>
