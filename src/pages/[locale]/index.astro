---
import { AnimatedSection } from "@/components/AnimatedSection";
import AppCard from "@/components/AppCard.astro";
import { AppShowcase } from "@/components/AppShowcase";
import { useTranslations, type Locale } from "@/i18n/utils";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { ArrowRight, Star } from "lucide-react";

export function getStaticPaths() {
	return [{ params: { locale: "es" } }, { params: { locale: "pt" } }];
}

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);

const apps = await getCollection("apps", ({ slug }) => slug.startsWith(`${locale}/`));
const featuredApps = apps.slice(0, 4);

const blogPosts = await getCollection("blog", ({ slug }) => slug.startsWith(`${locale}/`));
const latestPosts = blogPosts
	.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
	.slice(0, 3);

const canonical = new URL(`/${locale}`, Astro.site).href;

const testimonials =
	locale === "es"
		? [
				{
					quote:
						"La mejor app de la Biblia TLA que he encontrado. La traducción es muy fácil de entender y la interfaz es súper intuitiva. La uso cada día.",
					name: "María G.",
					app: "Biblia TLA en Español",
					initials: "MG",
					gradient: "bg-brand-700",
				},
				{
					quote:
						"CartWise me cambió la vida. Sin complicaciones, funciona perfecto. La comparto con mi esposo y nunca tenemos problemas.",
					name: "Ana P.",
					app: "CartWise Lista de Compras",
					initials: "AP",
					gradient: "bg-accent-700",
				},
				{
					quote:
						"Increíble app. Leer la Biblia en TPT es una experiencia completamente diferente. La interfaz es limpia y muy fácil de navegar.",
					name: "Roberto M.",
					app: "Bible TPT",
					initials: "RM",
					gradient: "bg-gray-700",
				},
			]
		: [
				{
					quote:
						"Melhor app da Bíblia TLA que encontrei. A tradução é muito fácil de ler e a interface é super intuitiva. Uso todo dia.",
					name: "Maria G.",
					app: "Biblia TLA em Português",
					initials: "MG",
					gradient: "bg-brand-700",
				},
				{
					quote:
						"CartWise mudou minha vida. Sem complicação, funciona perfeitamente. Compartilho com meu marido e nunca temos problemas.",
					name: "Ana P.",
					app: "CartWise Lista de Compras",
					initials: "AP",
					gradient: "bg-accent-700",
				},
				{
					quote:
						"App incrível. Ler a Bíblia em TPT é uma experiência completamente diferente. A interface é limpa e muito fácil de navegar.",
					name: "Roberto M.",
					app: "Bible TPT",
					initials: "RM",
					gradient: "bg-gray-700",
				},
			];

const features =
	locale === "es"
		? [
				{
					num: "01",
					title: "Seguridad primero",
					desc: "Construidas con las mejores prácticas del sector. Tus datos nunca salen de tu dispositivo innecesariamente.",
				},
				{
					num: "02",
					title: "Experiencia de usuario",
					desc: "Interfaces intuitivas diseñadas alrededor de patrones de uso reales, no listas de funciones.",
				},
				{
					num: "03",
					title: "Alto rendimiento",
					desc: "Optimizadas desde cero. Tiempos de carga rápidos, animaciones fluidas, sin lag.",
				},
				{
					num: "04",
					title: "Nativas para Android",
					desc: "Construidas específicamente para Android. Siguen Material Design, se sienten como en casa en tu dispositivo.",
				},
				{
					num: "05",
					title: "Actualizaciones regulares",
					desc: "Mejoradas continuamente basándose en el feedback de usuarios. Siempre mejorando.",
				},
				{
					num: "06",
					title: "Soporte dedicado",
					desc: "Personas reales detrás de las apps. Respondemos, corregimos, escuchamos.",
				},
			]
		: [
				{
					num: "01",
					title: "Segurança em primeiro lugar",
					desc: "Criadas com as melhores práticas do setor. Seus dados nunca saem do dispositivo desnecessariamente.",
				},
				{
					num: "02",
					title: "Experiência do usuário",
					desc: "Interfaces intuitivas projetadas em torno de padrões de uso reais, não listas de funcionalidades.",
				},
				{
					num: "03",
					title: "Alto desempenho",
					desc: "Otimizadas do zero. Carregamento rápido, animações suaves, sem travamentos.",
				},
				{
					num: "04",
					title: "Nativas para Android",
					desc: "Criadas especificamente para Android. Seguem o Material Design, se encaixam perfeitamente no seu dispositivo.",
				},
				{
					num: "05",
					title: "Atualizações regulares",
					desc: "Melhoradas continuamente com base no feedback dos usuários. Sempre evoluindo.",
				},
				{
					num: "06",
					title: "Suporte dedicado",
					desc: "Pessoas reais por trás dos apps. Respondemos, corrigimos, ouvimos.",
				},
			];
---

<BaseLayout
	{canonical}
	description={t("home.subtitle")}
	locale={locale}
	showFooterCta={false}
	showHero={true}
	title={locale === "es"
		? "FusionCore Apps — Biblia TLA, CartWise y más para Android"
		: "FusionCore Apps — Biblia TLA, CartWise e mais para Android"}
>
	<!-- ─── HERO ─────────────────────────────────────────────────────────────── -->
	<div slot="hero">
		<div class="relative flex min-h-[88vh] items-center py-20 sm:py-28">
			<div class="relative z-10 grid w-full items-center gap-16 lg:grid-cols-[1fr_auto]">
				<div class="max-w-2xl space-y-8">
					<div class="section-label">
						<span class="section-label__dot"></span>
						<span>{t("home.overline")}</span>
					</div>
					<h1 class="display-title">
						{t("home.title")}<br />
						<span class="text-brand-700 dark:text-brand-400">{t("home.titleGradient")}</span>
					</h1>
					<p class="section-deck">
						{t("home.subtitle")}
					</p>
					<div
						class="flex items-center gap-6 border-y border-gray-200 py-5 sm:gap-8 dark:border-gray-800"
					>
						<div>
							<div class="editorial-num text-gray-900 dark:text-white">10K+</div>
							<div
								class="mt-1 text-xs font-medium tracking-wide text-gray-500 uppercase dark:text-gray-500"
							>
								{t("home.statsDownloads")}
							</div>
						</div>
						<div class="h-10 w-px flex-shrink-0 bg-gray-200 dark:bg-gray-800"></div>
						<div>
							<div class="editorial-num text-gray-900 dark:text-white">4.5★</div>
							<div
								class="mt-1 text-xs font-medium tracking-wide text-gray-500 uppercase dark:text-gray-500"
							>
								{t("home.statsRating")}
							</div>
						</div>
						<div class="h-10 w-px flex-shrink-0 bg-gray-200 dark:bg-gray-800"></div>
						<div>
							<div class="editorial-num text-gray-900 dark:text-white">100%</div>
							<div
								class="mt-1 text-xs font-medium tracking-wide text-gray-500 uppercase dark:text-gray-500"
							>
								{t("home.statsFree")}
							</div>
						</div>
					</div>
					<div class="flex flex-col items-start gap-4 pt-2 sm:flex-row">
						<a
							class="button button--primary group gap-2 px-7 py-3.5 text-base"
							href={`/${locale}/apps`}
						>
							<svg aria-hidden="true" class="h-4 w-4 flex-shrink-0" fill="none" viewBox="0 0 24 24">
								<path
									d="M3 20.5V3.5C3 2.91 3.34 2.39 3.84 2.15L13.69 12L3.84 21.85C3.34 21.6 3 21.09 3 20.5Z"
									fill="currentColor"
									opacity="0.85"></path>
								<path
									d="M16.81 15.12L6.05 21.34L14.54 12.85L16.81 15.12Z"
									fill="currentColor"
									opacity="0.7"></path>
								<path
									d="M20.16 10.81C20.5 11.08 20.75 11.5 20.75 12C20.75 12.5 20.53 12.9 20.18 13.18L17.89 14.5L15.39 12L17.89 9.5L20.16 10.81Z"
									fill="currentColor"></path>
								<path
									d="M6.05 2.66L16.81 8.88L14.54 11.15L6.05 2.66Z"
									fill="currentColor"
									opacity="0.7"></path>
							</svg>
							<span>{t("home.ctaPrimary")}</span>
							<ArrowRight className="h-4 w-4 transition-transform group-hover:translate-x-1" />
						</a>
						<a
							class="button button--ghost border border-gray-300 px-7 py-3.5 text-base dark:border-gray-700"
							href={`#features`}
						>
							{t("home.ctaSecondary")}
						</a>
					</div>
				</div>

				<div class="hidden items-center lg:flex" style="animation: float 7s ease-in-out infinite;">
					<AppShowcase client:media="(min-width: 1024px)" />
				</div>
			</div>
		</div>
	</div>

	<!-- ─── FEATURED APPS ─────────────────────────────────────────────────────── -->
	<AnimatedSection client:visible>
		<section class="featured-apps mt-4 mb-24">
			<div class="mb-12 flex items-end justify-between">
				<div>
					<div class="section-label mb-3">
						<span class="section-label__dot"></span>
						<span>{t("home.appsOverline")}</span>
					</div>
					<h2 class="section-title">
						{t("home.appsTitle")}
					</h2>
				</div>
				{
					featuredApps.length > 0 && (
						<a
							class="text-brand-700 hover:text-brand-800 dark:text-brand-400 dark:hover:text-brand-300 hidden items-center gap-1.5 text-sm font-semibold transition-colors sm:inline-flex"
							href={`/${locale}/apps`}
						>
							{t("home.appsViewAll")} <span>({apps.length})</span>
							<ArrowRight className="h-3.5 w-3.5" />
						</a>
					)
				}
			</div>

			{
				featuredApps.length > 0 ? (
					<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
						{featuredApps.map((app, index) => (
							<div class="animate-slide-up" style={`animation-delay: ${index * 80}ms`}>
								<AppCard app={app} featured={true} locale={locale} />
							</div>
						))}
					</div>
				) : (
					<div class="py-16 text-center">
						<p class="text-gray-500 dark:text-gray-400">{t("home.appsEmpty")}</p>
					</div>
				)
			}

			{
				featuredApps.length > 0 && (
					<div class="mt-8 text-center sm:hidden">
						<a class="button button--secondary" href={`/${locale}/apps`}>
							{t("home.appsViewAllMobile")}
							<span class="ml-1 text-gray-400">({apps.length})</span>
						</a>
					</div>
				)
			}
		</section>
	</AnimatedSection>

	<!-- ─── EXPIROO LAUNCH BAND ─── -->
	<AnimatedSection client:visible delay={0.05}>
		<section aria-labelledby="expiroo-heading" class="mb-24">
			<div class="cta-panel relative overflow-hidden rounded-3xl px-6 py-8 sm:px-10 sm:py-10">
				<div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
					<div class="flex items-start gap-4 sm:gap-5">
						<img
							alt=""
							class="h-14 w-14 flex-shrink-0 rounded-[16px] shadow-[0_10px_36px_rgba(0,0,0,0.45)] ring-1 ring-white/15 sm:h-16 sm:w-16"
							decoding="async"
							height="64"
							loading="lazy"
							src="/images/apps/expiroo/icon.png"
							width="64"
						/>
						<div class="min-w-0">
							<span
								class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[11px] font-bold tracking-wide uppercase"
								style="background: rgba(255,138,42,0.15); color: var(--color-accent-400);"
							>
								<span
									aria-hidden="true"
									class="h-1.5 w-1.5 rounded-full"
									style="background: var(--color-accent-400);"></span>
								{t("home.expirooBadge")}
							</span>
							<h2
								class="mt-2 text-white"
								id="expiroo-heading"
								style="font-family: var(--font-display); font-weight: 800; font-size: clamp(1.375rem, 1.1rem + 1.2vw, 1.875rem); letter-spacing: -0.03em; line-height: 1.1;"
							>
								{t("home.expirooTitle")}
							</h2>
							<p class="mt-1.5 max-w-md text-[15px] leading-relaxed text-white/70">
								{t("home.expirooDeck")}
							</p>
						</div>
					</div>
					<div class="flex flex-col gap-3 sm:flex-shrink-0 sm:flex-row sm:items-center">
						<a
							aria-label={t("home.expirooCtaAria")}
							class="button button--beta min-h-[44px] w-full gap-2 font-semibold focus:ring-white/70 focus:ring-offset-transparent sm:w-auto"
							href="https://groups.google.com/g/expiroo-testers"
							rel="noopener noreferrer"
							target="_blank"
						>
							<svg
								aria-hidden="true"
								class="h-4 w-4 flex-shrink-0"
								fill="none"
								stroke="currentColor"
								stroke-width="2.5"
								viewBox="0 0 24 24"
								><path
									d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
									stroke-linecap="round"
									stroke-linejoin="round"></path></svg
							>
							<span>{t("app.joinBeta")}</span>
						</a>
						<a
							aria-label={t("home.expirooSecondaryAria")}
							class="button min-h-[44px] w-full border border-white/25 text-white hover:bg-white/10 focus:ring-white/70 focus:ring-offset-transparent sm:w-auto"
							href={`/${locale}/apps/expiroo`}
						>
							{t("home.expirooSecondary")}
						</a>
					</div>
				</div>
			</div>
		</section>
	</AnimatedSection>

	<!-- ─── SOCIAL PROOF / STATS ─────────────────────────────────────────────── -->
	<section class="-mx-4 mb-0 sm:-mx-6 lg:-mx-8">
		<div class="social-proof-section relative overflow-hidden">
			<div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
				<!-- Stats row -->
				<AnimatedSection client:visible>
					<div class="mb-20 grid grid-cols-2 gap-8 sm:grid-cols-4">
						<div class="text-center">
							<div class="social-proof-stat-num">10K+</div>
							<div class="social-proof-stat-label">{t("home.statsDownloads")}</div>
						</div>
						<div class="text-center">
							<div class="social-proof-stat-num">4.5★</div>
							<div class="social-proof-stat-label">{t("home.statsRating")}</div>
						</div>
						<div class="text-center">
							<div class="social-proof-stat-num">5</div>
							<div class="social-proof-stat-label">{t("home.socialAppsPublished")}</div>
						</div>
						<div class="text-center">
							<div class="social-proof-stat-num" style="color: var(--color-accent-600);">
								{t("home.statsFree")}
							</div>
							<div class="social-proof-stat-label">{t("home.socialToDownload")}</div>
						</div>
					</div>
				</AnimatedSection>

				<!-- Testimonials -->
				<AnimatedSection client:visible delay={0.2}>
					<div class="mb-10">
						<div class="section-label mb-4">
							<span class="section-label__dot"></span>
							<span>{t("home.socialWhatUsersSay")}</span>
						</div>
						<h2 class="social-proof-heading">
							{t("home.socialTrustedBy")}
						</h2>
					</div>

					<div class="grid gap-5 sm:grid-cols-3">
						{
							testimonials.map((review) => (
								<div class="testimonial-card">
									<div class="mb-3 flex gap-0.5">
										{Array.from({ length: 5 }).map(() => (
											<Star className="h-4 w-4 text-yellow-400" fill="currentColor" />
										))}
									</div>
									<p class="testimonial-text">"{review.quote}"</p>
									<div class="testimonial-divider" />
									<div class="flex items-center gap-3 pt-4">
										<div
											class:list={[
												`flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full text-xs font-bold text-white`,
												review.gradient,
											]}
										>
											{review.initials}
										</div>
										<div>
											<div class="testimonial-name">{review.name}</div>
											<div class="testimonial-app">{review.app}</div>
										</div>
									</div>
								</div>
							))
						}
					</div>
				</AnimatedSection>
			</div>
		</div>
	</section>

	<!-- ─── FEATURES ─────────────────────────────────────────────────────────── -->
	<AnimatedSection client:visible delay={0.1}>
		<section class="-mx-4 bg-gray-50 py-24 sm:-mx-6 lg:-mx-8 dark:bg-transparent" id="features">
			<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
				<div class="mb-14">
					<div class="section-label mb-3">
						<span class="section-label__dot"></span>
						<span>{t("home.featuresOverline")}</span>
					</div>
					<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
						<h2 class="section-title max-w-md">
							{t("home.featuresTitle")}
						</h2>
						<p class="max-w-xs text-sm leading-relaxed text-gray-500 dark:text-gray-400">
							{t("home.featuresSubtitle")}
						</p>
					</div>
				</div>
				<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
					{
						features.map((f) => (
							<div class="feature-item">
								<span class="feature-num">{f.num}</span>
								<div>
									<h3 class="mb-1.5 text-base font-bold text-gray-900 dark:text-white">
										{f.title}
									</h3>
									<p class="text-sm leading-relaxed text-gray-600 dark:text-gray-400">{f.desc}</p>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</section>
	</AnimatedSection>

	<!-- ─── BLOG TEASER ────────────────────────────────────────────────────── -->
	{
		latestPosts.length > 0 && (
			<AnimatedSection client:visible delay={0.1}>
				<section class="pt-8 pb-24">
					<div class="mb-12 flex items-end justify-between">
						<div>
							<div class="section-label mb-3">
								<span class="section-label__dot" />
								<span>{t("home.blogOverline")}</span>
							</div>
							<h2 class="section-title">{t("home.blogTitle")}</h2>
						</div>
						<a
							class="text-brand-700 hover:text-brand-800 dark:text-brand-400 dark:hover:text-brand-300 hidden items-center gap-1.5 text-sm font-semibold transition-colors sm:inline-flex"
							href={`/${locale}/blog`}
						>
							{t("home.blogAllPosts")}
							<ArrowRight className="h-3.5 w-3.5" />
						</a>
					</div>
					<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
						{latestPosts.map((post, i) => (
							<a
								class="blog-teaser-card no-underline"
								href={`/${locale}/blog/${post.slug.replace(`${locale}/`, "")}`}
								style={`animation-delay: ${i * 80}ms`}
							>
								<div class="flex-1 space-y-3">
									{post.data.tags && post.data.tags.length > 0 && (
										<span class="bg-brand-50 dark:bg-brand-950/50 text-brand-700 dark:text-brand-400 inline-block rounded-full px-3 py-1 text-[11px] font-semibold tracking-wider uppercase">
											{post.data.tags[0]}
										</span>
									)}
									<h3 class="group-hover:text-brand-600 dark:group-hover:text-brand-400 text-base leading-snug font-bold text-gray-900 transition-colors dark:text-white">
										{post.data.title}
									</h3>
									<p class="line-clamp-2 text-sm leading-relaxed text-gray-500 dark:text-gray-400">
										{post.data.description}
									</p>
								</div>
								<div class="mt-5 flex items-center justify-between border-t border-gray-100 pt-4 dark:border-gray-700">
									<time class="text-xs font-medium text-gray-400 dark:text-gray-500">
										{post.data.publishedAt.toLocaleDateString(
											locale === "es" ? "es-419" : "pt-BR",
											{ month: "short", day: "numeric", year: "numeric" },
										)}
									</time>
									<span class="text-brand-700 dark:text-brand-400 inline-flex items-center gap-1 text-xs font-semibold">
										{t("home.blogRead")}
										<ArrowRight className="h-3 w-3 group-hover:translate-x-0.5 transition-transform" />
									</span>
								</div>
							</a>
						))}
					</div>
					<div class="mt-8 text-center sm:hidden">
						<a class="button button--secondary" href={`/${locale}/blog`}>
							{t("home.blogAllPosts")}
						</a>
					</div>
				</section>
			</AnimatedSection>
		)
	}

	<!-- ─── CTA ──────────────────────────────────────────────────────────────── -->
	<AnimatedSection client:visible delay={0.1}>
		<section class="-mx-4 mb-0 sm:-mx-6 lg:-mx-8">
			<div class="cta-band relative overflow-hidden">
				<div
					aria-hidden="true"
					class="pointer-events-none absolute inset-0 flex items-center justify-end overflow-hidden select-none"
				>
					<span
						class="pr-8 font-extrabold text-white/5"
						style="font-size: clamp(6rem, 18vw, 14rem); line-height: 1; letter-spacing: -0.05em; font-family: var(--font-display);"
						>FREE</span
					>
				</div>
				<div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-24 lg:px-8">
					<div class="max-w-xl">
						<div class="section-label mb-5 text-white/60">
							<span>{t("home.ctaOverline")}</span>
						</div>
