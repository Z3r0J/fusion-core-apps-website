---
import AppGrid from "@/components/AppGrid.tsx";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

/* eslint-disable astro/no-set-html-directive -- only the JSON-LD <script> below uses set:html; its data is ours and "<" is escaped */
const entries = await getCollection("apps", ({ slug }) => slug.startsWith("en/"));
const apps = entries.map(({ slug, data }) => ({
	slug: slug.replace("en/", ""),
	title: data.title,
	tagline: data.tagline,
	description: data.description,
	category: data.category,
	icon: data.icon,
	playUrl: data.playUrl,
	price: data.price ?? "Free",
	tags: data.tags ?? [],
	rating: data.rating,
	downloadsLabel: data.downloads ?? "1K+",
	version: data.version,
	lastUpdated: data.lastUpdated,
	beta: data.beta ?? false,
	betaGroupUrl: data.betaGroupUrl,
}));

const canonical = new URL("/apps", Astro.site).href;
const totalDownloads = "10K+";
const categories = [...new Set(apps.map((a) => a.category))];
---

<BaseLayout
	{canonical}
	description="All FusionCore Android apps: Bible TPT, Biblia TLA, CartWise grocery list, Claimly warranty scanner and Expiroo. Free on Google Play."
	title="Android Apps: Bible, Grocery & Productivity — FusionCore"
>
	<script
		is:inline
		set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "ItemList",
			"name": "FusionCore Apps",
			"description": "All Android apps published by FusionCore Apps on Google Play",
			"url": canonical,
			"numberOfItems": apps.length,
			"itemListElement": apps.map((app, i) => ({
				"@type": "ListItem",
				"position": i + 1,
				"name": app.title,
				"url": `https://www.fusioncoreapps.com/apps/${app.slug}`,
			})),
		}).replace(/</g, "\\u003c")}
		slot="head"
		type="application/ld+json"
	/>
	<Breadcrumbs
		items={[
			{ label: "Home", href: "/" },
			{ label: "Apps", href: "/apps" },
		]}
	/>

	<!-- Page Header -->
	<div
		class="relative -mx-4 mb-12 overflow-hidden px-4 pt-12 pb-14 sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8"
	>
		<div class="relative mx-auto max-w-7xl">
			<div class="section-label mb-4">
				<span class="section-label__dot"></span>
				<span>Google Play · Verified Developer</span>
			</div>

			<div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
				<div>
					<h1 class="page-title">All Applications</h1>
					<p class="mt-3 max-w-lg text-lg text-gray-500 dark:text-gray-400">
						{apps.length} free app{apps.length !== 1 ? "s" : ""} · {totalDownloads} downloads · {
							categories.join(", ")
						}
					</p>
				</div>

				<!-- Mini stats -->
				<div class="flex shrink-0 items-center gap-6">
					<div class="text-center">
						<div class="text-2xl font-extrabold tracking-tight text-gray-900 dark:text-white">
							{apps.length}
						</div>
						<div
							class="mt-0.5 text-xs font-semibold tracking-wider text-gray-400 uppercase dark:text-gray-500"
						>
							Apps
						</div>
					</div>
					<div class="h-8 w-px bg-gray-200 dark:bg-gray-800"></div>
					<div class="text-center">
						<div class="text-2xl font-extrabold tracking-tight text-gray-900 dark:text-white">
							{totalDownloads}
						</div>
						<div
							class="mt-0.5 text-xs font-semibold tracking-wider text-gray-400 uppercase dark:text-gray-500"
						>
							Downloads
						</div>
					</div>
					<div class="h-8 w-px bg-gray-200 dark:bg-gray-800"></div>
					<div class="text-center">
						<div class="text-2xl font-extrabold tracking-tight text-gray-900 dark:text-white">
							Free
						</div>
						<div
							class="mt-0.5 text-xs font-semibold tracking-wider text-gray-400 uppercase dark:text-gray-500"
						>
							Always
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- App Grid -->
	<AppGrid apps={apps} client:load />
</BaseLayout>
