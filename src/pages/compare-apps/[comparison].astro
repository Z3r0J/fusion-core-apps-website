---
import ComparisonJsonLd from "@/components/ComparisonJsonLd.astro";
import ComparisonLayout from "@/components/ComparisonLayout.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { COMPARE_APP_META, comparisonPath, comparisonSlug } from "@/lib/compareApps";
import { withBrand } from "@/lib/seo";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
	const entries = await getCollection("comparisons", ({ slug }) =>
		slug.startsWith("en/"),
	);
	return entries.map((e) => ({
		params: { comparison: comparisonSlug(e.data.app, e.data.competitorSlug) },
		props: { entry: e },
	}));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

// Resolve related items from sibling en entries of the same app
const allEn = await getCollection("comparisons", ({ slug }) =>
	slug.startsWith("en/"),
);
const relatedItems = (entry.data.relatedSlugs ?? [])
	.map((s: string) => {
		const match = allEn.find(
			(e) => e.data.app === entry.data.app && e.data.competitorSlug === s,
		);
		return match
			? { slug: match.data.competitorSlug, competitorName: match.data.competitorName }
			: null;
	})
	.filter(Boolean) as { slug: string; competitorName: string }[];

const canonical = new URL(
	comparisonPath("en", entry.data.app, entry.data.competitorSlug),
	Astro.site,
).href;
const ogImage = COMPARE_APP_META[entry.data.app].ogImage;
---

<BaseLayout
	title={withBrand(entry.data.title)}
	description={entry.data.description}
	ogImage={ogImage.src}
	ogImageWidth={ogImage.width}
	ogImageHeight={ogImage.height}
	canonical={canonical}
	locale="en"
	showFooterCta={false}
>
	<ComparisonJsonLd entry={entry} url={canonical} locale="en" />
	<ComparisonLayout {...entry.data} locale="en" relatedItems={relatedItems}>
		<Content />
	</ComparisonLayout>
</BaseLayout>
